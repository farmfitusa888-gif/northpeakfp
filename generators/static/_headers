/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' is required for script-src because the GA4 config and the
  # IntersectionObserver feature-test are inline on a static site with no
  # nonce mechanism. It still blocks script from any host not listed, which is
  # the attack this actually defends against. Style is inline throughout.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed-by-content assets are safe to cache forever. style.css and app.js are
# NOT content-hashed, so they get a short cache with revalidation instead —
# otherwise a rebuild would leave visitors on a stale stylesheet for a year.
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/style.css
  Cache-Control: public, max-age=3600, must-revalidate
/assets/app.js
  Cache-Control: public, max-age=3600, must-revalidate

# summit.js and the three bundle are not content-hashed either, so they follow
# the same revalidate rule as the other scripts. Serving them immutable would
# strand visitors on an old scene after a rebuild.
/assets/summit.js
  Cache-Control: public, max-age=3600, must-revalidate
/assets/vendor/three.summit.js
  Cache-Control: public, max-age=86400, must-revalidate
